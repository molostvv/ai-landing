# Для Apache. На Nginx те же правила задаются в конфиге сервера (см. README.md).
Options -Indexes
AddDefaultCharset utf-8
DirectoryIndex index.html

# Не отдавать настройки и служебные файлы
<FilesMatch "^(config\.php|config\.example\.php|README\.md|\..*)$">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
